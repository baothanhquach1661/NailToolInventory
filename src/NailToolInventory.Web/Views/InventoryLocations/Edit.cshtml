@model NailToolInventory.ViewModels.EditInventoryLocationViewModel

@{
    ViewData["Title"] = "Edit Location";
}

<h1>Edit Location</h1>

<p class="text-muted">
    Update warehouse information and fulfillment settings.
</p>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Location Code
                </label>

                <input value="@Model.Code" class="form-control" disabled />

                <div class="form-text">
                    Location codes cannot be changed.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>

                <input asp-for="Name" class="form-control" />

                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>

                <textarea asp-for="Address" class="form-control" rows="3"></textarea>

                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FulfillmentPriority" class="form-label"></label>

                <input asp-for="FulfillmentPriority" class="form-control" min="1" />

                <div class="form-text">
                    Smaller numbers have higher priority.
                </div>

                <span asp-validation-for="FulfillmentPriority" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="CanFulfillOnlineOrders" class="form-check-input" />

                <label asp-for="CanFulfillOnlineOrders" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}