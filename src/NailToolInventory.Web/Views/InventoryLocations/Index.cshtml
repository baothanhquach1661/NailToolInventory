@model NailToolInventory.ViewModels.InventoryLocationListViewModel

@{
    ViewData["Title"] = "Inventory Locations";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1>Inventory Locations</h1>

        <p class="text-muted">
            View warehouses and inventory availability
            across locations.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Location
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (Model.Locations.Count == 0)
{
    <div class="alert alert-info">
        No inventory locations were found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Priority</th>
                    <th>Code</th>
                    <th>Location</th>
                    <th>Products</th>
                    <th>On Hand</th>
                    <th>Reserved</th>
                    <th>Available</th>
                    <th>Online Orders</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var location in Model.Locations)
                {
                    <tr>
                        <td>@location.FulfillmentPriority</td>

                        <td>
                            <strong>@location.Code</strong>
                        </td>

                        <td>
                            <div>@location.Name</div>

                            @if (!string.IsNullOrWhiteSpace(
                                location.Address))
                            {
                                <small class="text-muted">
                                    @location.Address
                                </small>
                            }
                        </td>

                        <td>@location.ProductCount</td>

                        <td>@location.QuantityOnHand</td>

                        <td>@location.ReservedQuantity</td>

                        <td>
                            <strong>
                                @location.AvailableQuantity
                            </strong>
                        </td>

                        <td>
                            @if (location.CanFulfillOnlineOrders)
                            {
                                <span class="badge bg-primary">
                                    Enabled
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Disabled
                                </span>
                            }
                        </td>

                        <td>
                            @if (location.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@location.Id" class="btn btn-sm btn-outline-dark me-1">
                                Edit
                            </a>

                            <form asp-action="ToggleStatus" asp-route-id="@location.Id" method="post" class="d-inline">

                                @if (location.IsActive)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Disable this location?');">
                                        Disable
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                        Enable
                                    </button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}