@using Microsoft.AspNetCore.Identity
@using NailToolInventory.Models

@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item d-flex align-items-center">
            <span class="nav-link text-dark">
                @User.Identity?.Name
            </span>

            @if (User.IsInRole("Admin"))
            {
                <span class="badge bg-primary me-3">
                    Admin
                </span>
            }
            else if (User.IsInRole("Staff"))
            {
                <span class="badge bg-info text-dark me-3">
                    Staff
                </span>
            }
        </li>

        <li class="nav-item">
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action(
                                        "Index",
                                        "Home",
                                        new { area = "" })" method="post">

                <button type="submit" class="nav-link btn btn-link text-dark">
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">
                Login
            </a>
        </li>
    }
</ul>