@model NailToolInventory.ViewModels.StockTransferListViewModel
@using NailToolInventory.Models

@{
    ViewData["Title"] = "Stock Transfers";

    var successMessage =
        TempData["SuccessMessage"]?.ToString();

    var errorMessage =
        TempData["ErrorMessage"]?.ToString();
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1>Stock Transfers</h1>

        <p class="text-muted">
            Move inventory between warehouse locations.
        </p>
    </div>

    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            Create Transfer
        </a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (Model.Transfers.Count == 0)
{
    <div class="alert alert-info">
        No stock transfers have been created.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Transfer</th>
                    <th>Source</th>
                    <th>Destination</th>
                    <th>Products</th>
                    <th>Quantity</th>
                    <th>Received</th>
                    <th>Status</th>
                    <th>Created By</th>
                    <th>Created</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var transfer in Model.Transfers)
                {
                    var statusClass =
                        transfer.Status switch
                        {
                            StockTransferStatus.Draft =>
                                "bg-secondary",

                            StockTransferStatus.InTransit =>
                                "bg-primary",

                            StockTransferStatus.PartiallyReceived =>
                                "bg-warning text-dark",

                            StockTransferStatus.Completed =>
                                "bg-success",

                            StockTransferStatus.Cancelled =>
                                "bg-dark",

                            _ => "bg-secondary"
                        };

                    var statusText =
                        transfer.Status switch
                        {
                            StockTransferStatus.InTransit =>
                                "In Transit",

                            StockTransferStatus.PartiallyReceived =>
                                "Partially Received",

                            _ => transfer.Status.ToString()
                        };

                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@transfer.Id" class="fw-semibold text-decoration-none">
                                @transfer.TransferNumber
                            </a>
                        </td>

                        <td>@transfer.SourceLocationName</td>

                        <td>@transfer.DestinationLocationName</td>

                        <td>@transfer.ProductCount</td>

                        <td>@transfer.TotalQuantity</td>

                        <td>
                            @transfer.TotalReceived
                            /
                            @transfer.TotalQuantity
                        </td>

                        <td>
                            <span class="badge @statusClass">
                                @statusText
                            </span>
                        </td>

                        <td>
                            @(transfer.CreatedByName ?? "Unknown")
                        </td>

                        <td>
                            @transfer.CreatedAtUtc
                            .ToLocalTime()
                            .ToString("yyyy-MM-dd HH:mm")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}