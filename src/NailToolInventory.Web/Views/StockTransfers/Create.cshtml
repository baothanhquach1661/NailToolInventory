@model NailToolInventory.ViewModels.CreateStockTransferViewModel

@{
    ViewData["Title"] = "Create Stock Transfer";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1>Create Stock Transfer</h1>

        <p class="text-muted">
            Create a draft transfer between two warehouse locations.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to Transfers
    </a>
</div>

<form asp-action="Create" method="post" id="transfer-form">

    <div asp-validation-summary="All" class="text-danger mb-3">
    </div>

    <div class="card mb-4">
        <div class="card-header">
            Transfer Information
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="SourceLocationId" class="form-label">
                    </label>

                    <select asp-for="SourceLocationId" asp-items="Model.Locations" class="form-select">
                        <option value="">
                            Select source location
                        </option>
                    </select>

                    <span asp-validation-for="SourceLocationId" class="text-danger">
                    </span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DestinationLocationId" class="form-label">
                    </label>

                    <select asp-for="DestinationLocationId" asp-items="Model.Locations" class="form-select">
                        <option value="">
                            Select destination location
                        </option>
                    </select>

                    <span asp-validation-for="DestinationLocationId" class="text-danger">
                    </span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Reference" class="form-label">
                    </label>

                    <input asp-for="Reference" class="form-control" placeholder="Example: TRANSFER-1001" />

                    <span asp-validation-for="Reference" class="text-danger">
                    </span>
                </div>

                <div class="col-12">
                    <label asp-for="Notes" class="form-label">
                    </label>

                    <textarea asp-for="Notes" class="form-control" rows="3">
                    </textarea>

                    <span asp-validation-for="Notes" class="text-danger">
                    </span>
                </div>
            </div>
        </div>
    </div>


    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Products</span>

            <button type="button" id="add-product" class="btn btn-sm btn-outline-primary">
                Add Product
            </button>
        </div>

        <div class="card-body">
            <div id="transfer-items">
                @for (var index = 0;
                      index < Model.Items.Count;
                      index++)
                {
                    <div class="transfer-item-row border rounded p-3 mb-3">
                        <div class="row g-3 align-items-start">
                            <div class="col-md-7">
                                <label asp-for="Items[index].ProductId" class="form-label product-label">
                                </label>

                                <select asp-for="Items[index].ProductId" asp-items="Model.Products"
                                        class="form-select product-field">
                                    <option value="">
                                        Select product
                                    </option>
                                </select>

                                <span asp-validation-for="Items[index].ProductId" class="text-danger product-validation">
                                </span>
                            </div>

                            <div class="col-md-3">
                                <label asp-for="Items[index].Quantity" class="form-label quantity-label">
                                </label>

                                <input asp-for="Items[index].Quantity" class="form-control quantity-field" min="1" />

                                <span asp-validation-for="Items[index].Quantity" class="text-danger quantity-validation">
                                </span>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label d-block">
                                    &nbsp;
                                </label>

                                <button type="button" class="btn btn-outline-danger remove-product">
                                    Remove
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>


    <button type="submit" class="btn btn-primary">
        Create Draft Transfer
    </button>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Cancel
    </a>
</form>


<template id="transfer-item-template">
    <div class="transfer-item-row border rounded p-3 mb-3">
        <div class="row g-3 align-items-start">
            <div class="col-md-7">
                <label class="form-label product-label">
                    Product
                </label>

                <select name="Items[__index__].ProductId" class="form-select product-field" data-val="true"
                        data-val-required="Product is required.">
                    <option value="">
                        Select product
                    </option>

                    @foreach (var product in Model.Products)
                    {
                        <option value="@product.Value">
                            @product.Text
                        </option>
                    }
                </select>

                <span class="text-danger field-validation-valid product-validation"
                      data-valmsg-for="Items[__index__].ProductId" data-valmsg-replace="true">
                </span>
            </div>

            <div class="col-md-3">
                <label class="form-label quantity-label">
                    Quantity
                </label>

                <input name="Items[__index__].Quantity" type="number" value="1" min="1"
                       class="form-control quantity-field" data-val="true" data-val-required="Quantity is required."
                       data-val-range="Quantity must be greater than zero." data-val-range-min="1"
                       data-val-range-max="2147483647" />

                <span class="text-danger field-validation-valid quantity-validation"
                      data-valmsg-for="Items[__index__].Quantity" data-valmsg-replace="true">
                </span>
            </div>

            <div class="col-md-2">
                <label class="form-label d-block">
                    &nbsp;
                </label>

                <button type="button" class="btn btn-outline-danger remove-product">
                    Remove
                </button>
            </div>
        </div>
    </div>
</template>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const form =
                document.getElementById("transfer-form");

            const container =
                document.getElementById("transfer-items");

            const template =
                document.getElementById(
                    "transfer-item-template");

            const addButton =
                document.getElementById("add-product");


            function reindexRows() {
                const rows =
                    container.querySelectorAll(
                        ".transfer-item-row");

                rows.forEach((row, index) => {
                    const productField =
                        row.querySelector(
                            ".product-field");

                    const productLabel =
                        row.querySelector(
                            ".product-label");

                    const productValidation =
                        row.querySelector(
                            ".product-validation");

                    const quantityField =
                        row.querySelector(
                            ".quantity-field");

                    const quantityLabel =
                        row.querySelector(
                            ".quantity-label");

                    const quantityValidation =
                        row.querySelector(
                            ".quantity-validation");


                    productField.name =
                        `Items[${index}].ProductId`;

                    productField.id =
                        `Items_${index}__ProductId`;

                    productLabel.htmlFor =
                        productField.id;

                    productValidation.setAttribute(
                        "data-valmsg-for",
                        productField.name);


                    quantityField.name =
                        `Items[${index}].Quantity`;

                    quantityField.id =
                        `Items_${index}__Quantity`;

                    quantityLabel.htmlFor =
                        quantityField.id;

                    quantityValidation.setAttribute(
                        "data-valmsg-for",
                        quantityField.name);
                });

                const removeButtons =
                    container.querySelectorAll(
                        ".remove-product");

                removeButtons.forEach(button => {
                    button.disabled =
                        rows.length <= 1;
                });
            }


            function refreshValidation() {
                if (!window.jQuery ||
                    !window.jQuery.validator ||
                    !window.jQuery.validator.unobtrusive) {
                    return;
                }

                const formElement =
                    window.jQuery(form);

                formElement.removeData("validator");
                formElement.removeData(
                    "unobtrusiveValidation");

                window.jQuery.validator
                    .unobtrusive
                    .parse(formElement);
            }


            addButton.addEventListener(
                "click",
                () => {
                    const index =
                        container.querySelectorAll(
                            ".transfer-item-row")
                            .length;

                    const markup =
                        template.innerHTML.replace(
                            /__index__/g,
                            index.toString());

                    container.insertAdjacentHTML(
                        "beforeend",
                        markup);

                    reindexRows();
                    refreshValidation();
                });


            container.addEventListener(
                "click",
                event => {
                    const removeButton =
                        event.target.closest(
                            ".remove-product");

                    if (!removeButton) {
                        return;
                    }

                    removeButton
                        .closest(".transfer-item-row")
                        .remove();

                    reindexRows();
                    refreshValidation();
                });


            reindexRows();
        })();
    </script>
}