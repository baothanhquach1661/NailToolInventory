@using NailToolInventory.Models
@model NailToolInventory.ViewModels.ProductHistoryViewModel


@{
    ViewData["Title"] = "Transaction History";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1>Transaction History</h1>
        <p class="text-muted mb-0">
            Review all inventory movements for this product.
        </p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to Products
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Model.ProductName</h5>

        <dl class="row mb-0">
            <dt class="col-sm-3">SKU</dt>
            <dd class="col-sm-9">@Model.ProductSku</dd>

            <dt class="col-sm-3">Current Inventory</dt>
            <dd class="col-sm-9">@Model.CurrentQuantity</dd>
        </dl>
    </div>
</div>

@if (Model.Transactions.Count == 0)
{
    <div class="alert alert-info">
        This product does not have any inventory transactions.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Quantity</th>
                    <th>Before</th>
                    <th>After</th>
                    <th>Reference</th>
                    <th>Notes</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var transaction in Model.Transactions)
                {
                    var quantityChange =
                        transaction.QuantityAfter -
                        transaction.QuantityBefore;

                    var quantityText = quantityChange > 0
                        ? $"+{quantityChange}"
                        : quantityChange.ToString();

                    var quantityColor = quantityChange > 0
                        ? "text-success"
                        : quantityChange < 0
                            ? "text-danger"
                            : "text-muted";

                    <tr>
                        <td>
                            @transaction.CreatedAtUtc.ToString(
                                "yyyy-MM-dd HH:mm 'UTC'")
                        </td>

                        <td>
                            @switch (transaction.Type)
                            {
                                case InventoryTransactionType.Receipt:
                                    <span class="badge bg-success">
                                        Receipt
                                    </span>
                                    break;

                                case InventoryTransactionType.Issue:
                                    <span class="badge bg-danger">
                                        Issue
                                    </span>
                                    break;

                                case InventoryTransactionType.Adjustment:
                                    <span class="badge bg-warning text-dark">
                                        Adjustment
                                    </span>
                                    break;
                            }
                        </td>

                        <td class="fw-semibold @quantityColor">
                            @quantityText
                        </td>

                        <td>@transaction.QuantityBefore</td>
                        <td>@transaction.QuantityAfter</td>

                        <td>
                            @(string.IsNullOrWhiteSpace(transaction.Reference)
                                ? "—"
                                : transaction.Reference)
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(transaction.Notes)
                                ? "—"
                                : transaction.Notes)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}