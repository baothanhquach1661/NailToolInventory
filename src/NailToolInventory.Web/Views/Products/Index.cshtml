@model IReadOnlyList<NailToolInventory.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Products</h1>
        <p class="text-muted mb-0">
            Manage nail-tool products and inventory levels.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add Product
    </a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No products have been created yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Cost</th>
                    <th>Price</th>
                    <th>Inventory</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Sku</td>
                        <td>@product.Name</td>
                        <td>@product.Category</td>
                        <td>@product.CostPrice.ToString("C")</td>
                        <td>@product.SellingPrice.ToString("C")</td>
                        <td>
                            @product.QuantityOnHand
                            <span class="text-muted">
                                / reorder at @product.ReorderLevel
                            </span>
                        </td>
                        <td>
                            @if (product.IsLowStock())
                            {
                                <span class="badge bg-danger">
                                    Low Stock
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    In Stock
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="ReceiveStock" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">
                                Receive Stock
                            </a>
                            <a asp-action="IssueStock" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger ms-1">
                                Issue Stock
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}