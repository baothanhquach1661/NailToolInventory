@model NailToolInventory.ViewModels.AdjustStockViewModel

@{
    ViewData["Title"] = "Adjust Inventory";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="mb-4">
            <h1>Adjust Inventory</h1>

            <p class="text-muted">
                Correct inventory at a selected location
                based on a physical stock count.
            </p>
        </div>

        <div class="alert alert-warning">
            Use Adjustment only to correct an inventory
            difference. Use Receive Stock or Issue Stock
            for normal inventory movements.
        </div>

        <form asp-action="AdjustStock" method="get" class="card card-body mb-4">

            <input type="hidden" name="id" value="@Model.ProductId" />

            <label asp-for="InventoryLocationId" class="form-label"></label>

            <select asp-for="InventoryLocationId" asp-items="Model.Locations" class="form-select"
                    onchange="this.form.submit()">
            </select>

            <div class="form-text">
                Changing the location reloads its current
                inventory information.
            </div>

            <noscript>
                <button type="submit" class="btn btn-outline-primary mt-2">
                    Load Location
                </button>
            </noscript>
        </form>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">
                    @Model.ProductName
                </h5>

                <dl class="row mb-0">
                    <dt class="col-sm-4">SKU</dt>

                    <dd class="col-sm-8">
                        @Model.Sku
                    </dd>

                    <dt class="col-sm-4">Location</dt>

                    <dd class="col-sm-8">
                        @Model.SelectedLocationName
                    </dd>

                    <dt class="col-sm-4">On Hand</dt>

                    <dd class="col-sm-8">
                        @Model.CurrentQuantity
                    </dd>

                    <dt class="col-sm-4">Reserved</dt>

                    <dd class="col-sm-8">
                        @Model.ReservedQuantity
                    </dd>
                </dl>
            </div>
        </div>

        <form asp-action="AdjustStock" method="post">
            <input asp-for="ProductId" type="hidden" />

            <input asp-for="InventoryLocationId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="NewQuantity" class="form-label"></label>

                <input asp-for="NewQuantity" class="form-control" type="number" min="@Model.ReservedQuantity" />

                <span asp-validation-for="NewQuantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Reference" class="form-label"></label>

                <input asp-for="Reference" class="form-control" placeholder="Example: COUNT-2026-09" />

                <span asp-validation-for="Reference" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>

                <textarea asp-for="Notes" class="form-control" rows="3"
                          placeholder="Reason for the inventory difference"></textarea>

                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    Save Adjustment
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}