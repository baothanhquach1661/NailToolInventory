@model NailToolInventory.ViewModels.AdjustStockViewModel

@{
    ViewData["Title"] = "Adjust Inventory";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="mb-4">
            <h1>Adjust Inventory</h1>

            <p class="text-muted">
                Correct inventory based on a physical stock count.
            </p>
        </div>

        <div class="alert alert-warning">
            Use Adjustment only to correct an inventory difference.
            Use Receive Stock or Issue Stock for normal inventory movements.
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">@Model.ProductName</h5>

                <dl class="row mb-0">
                    <dt class="col-sm-4">SKU</dt>
                    <dd class="col-sm-8">@Model.Sku</dd>

                    <dt class="col-sm-4">Current Inventory</dt>
                    <dd class="col-sm-8">
                        @Model.CurrentQuantity
                    </dd>
                </dl>
            </div>
        </div>

        <form asp-action="AdjustStock" method="post">
            <input asp-for="ProductId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="NewQuantity" class="form-label">
                </label>

                <input asp-for="NewQuantity" class="form-control" type="number" min="0" />

                <span asp-validation-for="NewQuantity" class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Reference" class="form-label">
                </label>

                <input asp-for="Reference" class="form-control" placeholder="Example: COUNT-2026-09" />

                <span asp-validation-for="Reference" class="text-danger">
                </span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label">
                </label>

                <textarea asp-for="Notes" class="form-control" rows="3"
                          placeholder="Reason for the inventory difference">
                </textarea>

                <span asp-validation-for="Notes" class="text-danger">
                </span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    Save Adjustment
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}